+/* Coverage is decided with exact 64 bit edge functions evaluated at pixel centres.        */
+/* Big quads near the camera (e.g. the water and bedrock planes around the map) project   */
+/* vertices millions of pixels off screen: in 32 bit ints the edge products overflowed,   */
+/* flipping triangles' winding so they were culled (leaving holes), and float rounding    */
+/* left cracks along shared edges. Pixels exactly on an edge go to one triangle only      */
+/* (top-left style rule), so translucent surfaces are not blended twice along diagonals.  */
+#define SCREEN_COORD_MAX 268435456.0f /* 2^28: keeps every edge product below 2^61 */
+
+static CC_INLINE int ScreenCoord(float v) {
+	if (v >  SCREEN_COORD_MAX) return  (int)SCREEN_COORD_MAX;
+	if (v < -SCREEN_COORD_MAX) return -(int)SCREEN_COORD_MAX;
+	return (int)v;
+}
+
+/* twice the edge function of a->b at the centre of pixel (px, py) */
+static CC_INLINE cc_int64 EdgeAtCentre(int ax, int ay, int bx, int by, int px, int py) {
+	return (cc_int64)(bx - ax) * (2 * py + 1 - 2 * ay) - (cc_int64)(by - ay) * (2 * px + 1 - 2 * ax);
+}
+
+/* 0 when edge a->b owns the pixel centres lying exactly on it, -1 otherwise */
+static CC_INLINE int EdgeBias(int ax, int ay, int bx, int by) {
+	return (by > ay || (by == ay && bx < ax)) ? 0 : -1;
+}
