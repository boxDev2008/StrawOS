+/* dst + ((A * (src - dst)) >> 8) per colour channel, A being src's alpha, for 4 pixels. */
+/* A * src and A * dst fit in 16 bits, and (P - Q) >> 8 = (P >> 8) - (Q >> 8) - borrow, */
+/* borrow being 1 when the low byte of P is below that of Q.                             */
+static CC_INLINE __m128i BlendHalf(__m128i src16, __m128i dst16) {
+	__m128i alpha = _mm_shufflehi_epi16(_mm_shufflelo_epi16(src16,
+		_MM_SHUFFLE(BITMAPCOLOR_A_SHIFT / 8, BITMAPCOLOR_A_SHIFT / 8, BITMAPCOLOR_A_SHIFT / 8, BITMAPCOLOR_A_SHIFT / 8)),
+		_MM_SHUFFLE(BITMAPCOLOR_A_SHIFT / 8, BITMAPCOLOR_A_SHIFT / 8, BITMAPCOLOR_A_SHIFT / 8, BITMAPCOLOR_A_SHIFT / 8));
+	__m128i byteMask = _mm_set1_epi16(0xFF);
+	__m128i P = _mm_mullo_epi16(alpha, src16);
+	__m128i Q = _mm_mullo_epi16(alpha, dst16);
+	__m128i borrow = _mm_cmpgt_epi16(_mm_and_si128(Q, byteMask), _mm_and_si128(P, byteMask)); /* -1 or 0 */
+	__m128i diff = _mm_add_epi16(_mm_sub_epi16(_mm_srli_epi16(P, 8), _mm_srli_epi16(Q, 8)), borrow);
+	return _mm_add_epi16(dst16, diff);
+}
+
+static CC_INLINE __m128i BlendPixels4(__m128i src, __m128i dst) {
+	__m128i zero = _mm_setzero_si128();
+	__m128i lo = BlendHalf(_mm_unpacklo_epi8(src, zero), _mm_unpacklo_epi8(dst, zero));
+	__m128i hi = BlendHalf(_mm_unpackhi_epi8(src, zero), _mm_unpackhi_epi8(dst, zero));
+	return _mm_packus_epi16(lo, hi);
+}
